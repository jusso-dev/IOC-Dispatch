DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intelrelay"

APP_BASE_URL="http://localhost:3000"

# Optional log level for the server + workers (debug|info|warn|error).
# Defaults to "info" in production, "debug" elsewhere.
# LOG_LEVEL="info"
# Set to "1" to force JSON log output even in development.
# LOG_JSON="0"

MAX_INDICATORS_PER_BATCH="500"
MAX_UPLOAD_SIZE_MB="5"

REDIS_URL="redis://localhost:6379"

# When true, large batches and Playwright jobs go to BullMQ workers.
QUEUE_ENABLED="true"
# Batches with >= this many provider attempts go through the queue.
QUEUE_BATCH_THRESHOLD="25"
# Per-job retry budget. Backoff is exponential starting at 5s.
QUEUE_JOB_ATTEMPTS="3"
# Hard timeout on every outbound provider HTTP call.
HTTP_TIMEOUT_MS="15000"

URLHAUS_AUTH_KEY=""
URLHAUS_ENABLED="true"
URLHAUS_RATE_LIMIT_PER_MINUTE="30"

URLSCAN_API_KEY=""
URLSCAN_DEFAULT_VISIBILITY="unlisted"
URLSCAN_ENABLED="true"
URLSCAN_RATE_LIMIT_PER_MINUTE="20"

GOOGLE_SAFE_BROWSING_API_KEY=""
GOOGLE_SAFE_BROWSING_ENABLED="true"

GOOGLE_WEB_RISK_API_KEY=""
GOOGLE_WEB_RISK_ENABLED="false"

ABUSEIPDB_API_KEY=""
ABUSEIPDB_ENABLED="true"
ABUSEIPDB_RATE_LIMIT_PER_MINUTE="30"

CROWDSEC_API_KEY=""
CROWDSEC_ENABLED="true"
CROWDSEC_RATE_LIMIT_PER_MINUTE="30"

VIRUSTOTAL_API_KEY=""
VIRUSTOTAL_ENABLED="false"
VIRUSTOTAL_ALLOW_ACTIVE_URL_SCAN="false"
VIRUSTOTAL_RATE_LIMIT_PER_MINUTE="4"

MISP_BASE_URL=""
MISP_API_KEY=""
MISP_VERIFY_TLS="true"
MISP_ENABLED="false"

OPENCTI_BASE_URL=""
OPENCTI_API_KEY=""
OPENCTI_ENABLED="false"

PHISHTANK_API_KEY=""
PHISHTANK_ENABLED="false"
PHISHTANK_PLAYWRIGHT_ENABLED="false"
PHISHTANK_USERNAME=""
PHISHTANK_PASSWORD=""

MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_DEFENDER_TI_ENABLED="false"

PLAYWRIGHT_ENABLED="false"
PLAYWRIGHT_SCREENSHOT_DIR="./screenshots"
CUSTOM_WEB_FORM_ENABLED="false"
CUSTOM_WEB_FORM_CONFIG_JSON=""
CUSTOM_WEB_FORM_USERNAME=""
CUSTOM_WEB_FORM_PASSWORD=""
